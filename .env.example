# 앱 설정 템플릿: 이 파일을 .env.local로 복사해서 값을 채우세요.
#   cp .env.example .env.local
# (.env는 autoenv 셸 스크립트 전용이며 앱은 읽지 않습니다)
APP_NAME=Upsong API
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://user@localhost/dbname

# 생성: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
